# ─── Database (required for orders, leads, admin) ───────────────────────────
# MongoDB Atlas connection string. Without it the public page renders preview
# content and order/lead submission returns "store not connected".
MONGODB_URI=mongodb+srv://mrlanding:8i66P0YRg86aAGyO@cluster0.hzu9wpj.mongodb.net/
MONGODB_DB=mrlanding

# ─── Admin authentication (required for /admin) ─────────────────────────────
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET= mrlandingmrlanding

# ─── Public site ────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, sitemap and admin CSRF origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=

# Comma-separated extra image hosts for next/image (e.g. your Cloudinary/S3 CDN)
# Example: res.cloudinary.com,cdn.example.com
IMAGE_HOSTS=

# ─── Privacy ────────────────────────────────────────────────────────────────
# Salt used to hash customer IPs for rate limiting/abuse review (never stored raw).
IP_HASH_SALT=

# ─── First admin user (used once by `npm run admin:create`) ─────────────────
ADMIN_EMAIL=admin@gmail.com 
ADMIN_PASSWORD=admin2211
ADMIN_NAME=

# ─── Online payment (not enabled; see README "Payments") ────────────────────
# PAYMENT_GATEWAY=
# PAYMENT_STORE_ID=
# PAYMENT_STORE_SECRET=
